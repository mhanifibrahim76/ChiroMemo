# ---------------------------------------------------------------------------
# ChiroMemo environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# Next.js loads `.env.local` automatically. The Prisma CLI does not, it reads
# `.env` through `dotenv` inside `prisma.config.ts` - see the note below.
# ---------------------------------------------------------------------------

# --- Database (Prisma -> Supabase Postgres) --------------------------------
# Supabase Dashboard > Project Settings > Database > Connection string.
# Use the "Direct connection" (port 5432) or the "Session pooler" (port 5432).
# Do NOT use the transaction pooler (port 6543) for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- Supabase Auth and client SDK -----------------------------------------
# Supabase Dashboard > Project Settings > API Keys
# These two are public: they are bundled into the browser code and are safe to
# use in Client Components. A project created before the 2024 key format also
# exposes them as "anon key"; either value goes in NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Server-only. Bypasses row level security; never expose to the browser.
# Not used by the authentication flow - it exists for later phases.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- AI (server-side only) -------------------------------------------------
# Google Gemini API. https://aistudio.google.com/apikey
# Not used yet (Phase 10). A placeholder value is enough until then.
GEMINI_API_KEY="YOUR-GEMINI-API-KEY"
