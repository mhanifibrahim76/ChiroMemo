# ---------------------------------------------------------------------------
# ChiroMemo environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Prisma -> Supabase Postgres
# Supabase Dashboard > Project Settings > Database > Connection string (URI mode)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Supabase Auth + client SDK
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Server-only. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Google Gemini API. Server-only. https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR-GEMINI-API-KEY"
