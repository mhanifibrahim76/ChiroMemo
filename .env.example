# ---------------------------------------------------------------------------
# ChiroMemo environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Configure these variables in your Vercel Project Settings for production.
# ---------------------------------------------------------------------------

# --- Supabase Auth and Data API --------------------------------------------
# Supabase Dashboard > Project Settings > API Keys
# These two are public: bundled into the browser code and safe for Client Components.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# --- Supabase Service Role Key (server-only) -------------------------------
# Supabase Dashboard > Project Settings > API Keys > service_role key.
# Bypasses row level security; NEVER expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- Google Gemini AI API (server-only) -----------------------------------
# Google AI Studio > Get API key. https://aistudio.google.com/apikey
# Required for AI Document Summarization (Phase 10), AI Search (Phase 11),
# and Personalized Recommendations (Phase 12).
GEMINI_API_KEY="YOUR-GEMINI-API-KEY"
