// ChiroMemo database schema (Supabase Postgres)
//
// Conventions:
//   - every model is owned by a User and filtered by userId
//   - ids are cuid(), except User.id which is the Supabase Auth user id
//   - createdAt / updatedAt are kept on every record
//
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection string lives in prisma.config.ts (Prisma 7 requirement).
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RoadmapStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ResourceType {
  PDF
  VIDEO
  WEBSITE
  BOOK
  COURSE
}

enum ActivityType {
  GOAL_CREATED
  GOAL_UPDATED
  STEP_COMPLETED
  RESOURCE_ADDED
  NOTE_CREATED
  SUMMARY_GENERATED
  STUDY_SESSION
}

/// A student account. The id is the Supabase Auth user id, so Prisma does not
/// create a foreign key to the Supabase-managed `auth.users` table.
model User {
  id        String   @id
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals            LearningGoal[]
  roadmaps         Roadmap[]
  resources        Resource[]
  notes            Note[]
  summaries        Summary[]
  learningActivities LearningActivity[]
}

/// What the student wants to achieve.
model LearningGoal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps  Roadmap[]
  resources Resource[]

  @@index([userId])
}

/// A step-by-step plan for reaching a learning goal.
model Roadmap {
  id              String   @id @default(cuid())
  userId          String
  goalId          String?
  title           String
  description     String?
  progressPercent Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  LearningGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  steps RoadmapStep[]

  @@index([userId])
  @@index([goalId])
}

/// One step of a roadmap.
model RoadmapStep {
  id          String             @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  order       Int
  status      RoadmapStepStatus  @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, order])
}

/// A learning material the student collects (PDF, video, website, book, course).
model Resource {
  id          String       @id @default(cuid())
  userId      String
  goalId      String?
  title       String
  type        ResourceType
  url         String?
  filePath    String?
  author      String?
  description String?
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      LearningGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  notes     Note[]
  summaries Summary[]

  @@index([userId])
  @@index([userId, type])
  @@index([goalId])
}

/// A personal note, optionally attached to a resource.
model Note {
  id         String   @id @default(cuid())
  userId     String
  resourceId String?
  title      String
  content    String
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resourceId])
}

/// An AI-generated summary of a resource or uploaded document.
model Summary {
  id         String   @id @default(cuid())
  userId     String
  resourceId String?
  content    String
  keyPoints  String[] @default([])
  model      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resourceId])
}

/// An event log used for progress tracking and dashboard analytics.
model LearningActivity {
  id         String       @id @default(cuid())
  userId     String
  type       ActivityType
  entityId   String?
  metadata   Json?
  occurredAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}
